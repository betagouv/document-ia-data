# Copier vers .env. dbt charge ce fichier automatiquement.
# En local : tunnel Scalingo + rôle dbt_dev → schéma dbt_dev de l'add-on.
#   scalingo --app <app> db-tunnel SCALINGO_POSTGRESQL_URL
DBT_TARGET=dev
DBT_HOST=127.0.0.1
DBT_PORT=10000
DBT_DBNAME=
DBT_USER=dbt_dev
DBT_PASSWORD=
DBT_SCHEMA=dbt_dev
DBT_SSLMODE=require
DBT_THREADS=4
